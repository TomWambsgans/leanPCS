def region (exprs forwards : ℕ) (port : Bool) : Region :=
  { name := "", roles := (Array.replicate exprs (.expr { linear := [], quadratic := [] }) ++
      Array.replicate forwards .forward) ++ (if port then #[.port [0]] else #[]) }

/-- Region specs `count exprs forwards port`, four numbers each. -/
def specs : List ℕ → List (ℕ × Region)
  | c :: e :: f :: p :: rest => (c, region e f (p == 1)) :: specs rest
  | _ => []

def nums (s : String) : List ℕ := (s.splitOn " ").filterMap String.toNat?

/-- A case agrees: `padCounts` returns the Rust's padded counts. -/
def agrees (line : String) : Bool :=
  match line.splitOn " | " with
  | [_, ins, outs] =>
    let sp := specs (nums ins)
    match padCounts (sp.map (·.1)).toArray (sp.map (·.2)).toArray with
    | .ok padded => padded.toList == nums outs
    | .error _ => false
  | _ => false

#guard vectors.length == 202
#guard vectors.all agrees

end RecCircuitTest.PadCounts
