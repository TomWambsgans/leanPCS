def limbHex (x : E) (i : Fin 3) : String := hexN (x.limb i).lane.toNat

def formText (f : Form) : String :=
  let terms := f.map fun (mono, c) ↦
    let m := if mono.isEmpty then "c" else ".".intercalate (mono.map toString)
    s!"{m}={limbHex c 0}:{limbHex c 1}:{limbHex c 2}"
  if terms.isEmpty then "0" else " ".intercalate terms

def lean : List String :=
  tablesKeccak.flatMap fun t ↦
    [s!"table {t.opcode} {t.width}"] ++
    t.columns.map (fun n ↦
      s!"col {n} {(keccakSlot n).elim "-" toString} {hexN (keccakSlotOffset n).toNat}") ++
    (t.flushes.push.zipIdx.map fun (tuple, k) ↦ s!"push {k} {" ; ".intercalate (tuple.map formText)}") ++
    (t.flushes.pull.zipIdx.map fun (tuple, k) ↦ s!"pull {k} {" ; ".intercalate (tuple.map formText)}")

/-- The first line that differs, if any. -/
def firstDiff : Option (String × String) :=
  ((lean.zip rust).find? fun (a, b) ↦ a != b)

#guard rust.length == 261
#guard lean.length == rust.length
#guard firstDiff.isNone

end UniStatementTest.KeccakTables
