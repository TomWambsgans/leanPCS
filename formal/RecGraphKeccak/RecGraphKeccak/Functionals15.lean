  rw [coordinateFunctionals_15, ← cfAK_rows l hl k hk, cfDotK]
  refine congrArg List.sum (List.map_congr_left fun m hm ↦ ?_)
  rw [← cfInitK_eq, cfInit_getD hk (List.mem_range.mp hm)]

